# --- Required ---
# Get your key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional model overrides ---
# Reasoning model for lesson plans + storyboards (defaults to Sonnet)
C2C_REASONING_MODEL=claude-sonnet-4-5
# Visual model for SVG panel generation (defaults to Sonnet)
C2C_VISUAL_MODEL=claude-sonnet-4-5

# --- Image backend ---
# Options:
#   svg     -> Claude-authored SVG vector panels (no extra key, free).
#   gemini  -> Google Nano Banana 2 / gemini-3.1-flash-image-preview (recommended for
#              photorealistic anime art). Requires GEMINI_API_KEY.
IMAGE_BACKEND=gemini
GEMINI_API_KEY=

# Reserved for future plugins (not yet wired)
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
