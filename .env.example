# =================== Text / reasoning provider ===================
# Lesson plan, worksheet, storyboard, and visual QA can run on either
# Anthropic Claude or Google Gemini. Set at least ONE of the two keys.
#   TEXT_PROVIDER: auto | anthropic | gemini
#   (auto = prefer Anthropic when its key is set, else Gemini)
TEXT_PROVIDER=auto

# Anthropic (optional — https://console.anthropic.com)
ANTHROPIC_API_KEY=
C2C_REASONING_MODEL=claude-opus-4-8
C2C_VISUAL_MODEL=claude-opus-4-8

# Gemini text model (used when TEXT_PROVIDER resolves to gemini)
GEMINI_TEXT_MODEL=gemini-3.5-flash

# =================== Image generation (REQUIRED) ===================
# Comic pages are drawn by Nano Banana Pro (Gemini 3 Pro Image).
# GEMINI_API_KEY is required for image generation — https://aistudio.google.com
GEMINI_API_KEY=
IMAGE_BACKEND=gemini
GEMINI_IMAGE_MODEL=gemini-3-pro-image
# 1K | 2K | 4K — 2K matches the sample Doraemon page quality.
GEMINI_IMAGE_RESOLUTION=2K

# =================== PDF OCR (optional but recommended) ===================
# Mathpix converts textbook PDFs to Markdown with real LaTeX math.
# Without these keys, PDF input falls back to local pdfplumber extraction.
# Get keys at https://mathpix.com/ocr
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# =================== QA ===================
# Pages scoring below this (or with a "fail" verdict) are auto-redrawn once
# with the QA reviewer's suggestions appended to the prompt.
C2C_QA_SCORE_THRESHOLD=80
# Whole-book consistency: books below this trigger redraws of the worst pages.
C2C_BOOK_SCORE_THRESHOLD=75
# Storyboards with a flow score below this are rewritten before rendering.
C2C_STORY_SCORE_THRESHOLD=75

# =================== Speed tips ===================
# - GEMINI_IMAGE_RESOLUTION=1K roughly halves per-page render time (2K = quality bar).
# - GEMINI_TEXT_MODEL=gemini-3.5-flash makes lesson/storyboard/QA much faster & cheaper.
# - Worksheet + storyboard already run in parallel; QA reviews each page in the
#   background while the next page is drawing.

# =================== Hosted deployment (studio on YOUR keys) ===================
# These only matter when you host the web studio for other people. Locally you
# can ignore them. NEVER put real keys in this file when hosting — set them in
# your host's dashboard (Railway/Render/etc.) so they stay off GitHub.
#
# Gate who can register (the owner pays for all API usage):
#   SIGNUP_INVITE_CODE: if set, new users must enter this exact code to sign up.
SIGNUP_INVITE_CODE=
#   SIGNUP_ALLOWED_EMAIL_DOMAINS: optional comma-separated allowlist, e.g. nyu.edu,school.edu
SIGNUP_ALLOWED_EMAIL_DOMAINS=
#
# Cap generation runs per rolling 24h so the budget can't be drained (0 = no cap):
MAX_RUNS_PER_USER_PER_DAY=10
MAX_RUNS_GLOBAL_PER_DAY=100
#
# Bind address: leave unset locally (loopback). On a host that injects PORT,
# the app auto-binds 0.0.0.0. Set HOST=0.0.0.0 explicitly if your host doesn't.
# HOST=0.0.0.0

# =================== Misc / persistence ===================
# On a host, point these at a mounted volume so accounts + comics survive redeploys:
#   C2C_DB_PATH=/data/studio.db
#   DEFAULT_OUTPUT_DIR=/data/outputs
#   C2C_OUTPUT_DIR=/data/outputs
C2C_OUTPUT_DIR=outputs
# C2C_DB_PATH=outputs/studio.db

# Reserved for future plugins (not yet wired)
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
