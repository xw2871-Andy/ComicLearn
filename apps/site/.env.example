# ============================================================
# ComicLearn marketing site — environment variables
# ============================================================
#
# The marketing site itself has NO secrets. It's a static
# Next.js app served from Vercel. The variables below are only
# used at *build* time to inject the right URLs into pages and
# OG images.
#
# Copy this file to `.env.local` and edit before deploying.
# ============================================================

# Public site URL. Used for canonical tags, OG images, sitemap.
NEXT_PUBLIC_SITE_DOMAIN=comiclearn.dpdns.org
NEXT_PUBLIC_SITE_URL=https://comiclearn.dpdns.org

# Hosted Studio backend origin. This is used by Vercel rewrites only; the
# public website sends users to /studio on the same domain.
STUDIO_ORIGIN=https://whose-attributes-park-twice.trycloudflare.com

# (Optional) Plausible / PostHog analytics — leave blank to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_POSTHOG_KEY=
